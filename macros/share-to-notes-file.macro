{"macroExportVersion": 1, "macro": {"m_GUID": 8800000168, "m_name": "Share to a quick-notes file", "m_description": "Pick OpenMacro in any app's Share sheet and the shared text or link is appended to /sdcard/OpenMacro/notes.txt (Apple Shortcuts' 'Save a web page to Notes').", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ShareTextTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "WriteToFileAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_logText": "{year}-{month_digit}-{dayofmonth} {shared_text}\n", "m_filename": "notes.txt", "m_append": true, "useAllFilesAccess": true, "allFilesPath": "/sdcard/OpenMacro"}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Saved to notes", "m_duration": 2}], "m_constraintList": []}}