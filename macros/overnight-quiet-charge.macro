{"macroExportVersion": 1, "macro": {"m_GUID": 8800000104, "m_name": "Overnight quiet charging", "m_description": "Plugs in at night: switches the phone to alarms-only (Do not disturb) and dims the screen while the charge runs between 22:00 and 07:00.", "m_category": "Battery", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ExternalPowerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_powerConnected": true, "m_powerConnectedOptions": [true, true, true]}], "m_actionList": [{"m_classType": "SetPriorityMode", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "SetBrightnessAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "setBrightnessValue": true, "m_brightnessPercent": 30}], "m_constraintList": [{"m_classType": "TimeOfDayConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_startHour": 22, "m_startMinute": 0, "m_endHour": 7, "m_endMinute": 0}]}}