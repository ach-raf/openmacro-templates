{"macroExportVersion": 1, "macro": {"m_GUID": 8800000147, "m_name": "Hue lights on when I arrive home", "m_description": "Turns every Philips Hue light on when you arrive home. Talks to your Hue bridge on the local network (no cloud, no account). Set the bridge IP and your API username in the macro variables (press the bridge button, then POST a devicetype body to http://<bridge>/api to get one) and the home coordinates in the trigger.", "m_category": "Location", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "LocationTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_enterArea": true, "m_geofenceId": "home", "m_newTriggerFromUnknown": 1, "m_latitude": 52.52, "m_longitude": 13.405, "m_radius": 150}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "http://{lv=bridge}/api/{lv=hueUser}/groups/0/action", "requestType": 2, "requestTimeOutSeconds": 30, "followRedirects": true, "contentType": "application/json", "contentBodyText": "{\"on\":true}"}}], "m_constraintList": [], "localVariables": [{"m_name": "bridge", "m_type": 2, "m_stringValue": "192.168.1.2"}, {"m_name": "hueUser", "m_type": 2, "m_stringValue": "YOUR-HUE-USERNAME"}]}}