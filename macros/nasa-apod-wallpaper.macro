{"macroExportVersion": 1, "macro": {"m_GUID": 8800000146, "m_name": "NASA picture of the day wallpaper", "m_description": "Each morning the NASA Astronomy Picture of the Day becomes your wallpaper. Uses NASA's public DEMO_KEY; get a free key at api.nasa.gov for heavy use. Days when NASA posts a video instead of an image are skipped.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 8, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.nasa.gov/planetary/apod?api_key=DEMO_KEY", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "apod"}, {"m_classType": "IfConditionAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 4001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "apod", "m_type": 4}, "dictionaryKeys": ["media_type"], "dictionaryType": 2, "m_stringValue": "image"}]}, {"m_classType": "HttpRequestAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "{lv=apod[url]}", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 2, "saveResponseUseAllFilesAccess": true, "saveResponseAllFilesAccessPath": "/sdcard/OpenMacro/apod.jpg"}}, {"m_classType": "SetWallpaperAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_scree