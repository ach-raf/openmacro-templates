{"macroExportVersion": 1, "macro": {"m_GUID": 8800000128, "m_name": "Quiet-hours missed call note", "m_description": "A missed call between 22:00 and 07:00 leaves you a notification, so overnight callers are never forgotten.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "CallMissedTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "NotificationAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "Missed call during quiet hours", "m_notificationText": "You missed a call overnight — maybe check who it was."}], "m_constraintList": [{"m_classType": "TimeOfDayConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_startHour": 22, "m_startMinute": 0, "m_endHour": 7, "m_endMinute": 0}]}}