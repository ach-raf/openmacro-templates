{"macroExportVersion": 1, "macro": {"m_GUID": 8800000145, "m_name": "Daily currency rate log", "m_description": "Once a day the USD to EUR rate is fetched (Frankfurter, no key) and appended as a line to /sdcard/OpenMacro/rates.csv, ready to open in any spreadsheet. Change the currency codes in the URL.", "m_category": "Finance", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 9, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "fx"}, {"m_classType": "WriteToFileAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_logText": "{lv=fx[date]},USD,EUR,{lv=fx[rates][EUR]}\n", "m_filename": "rates.csv", "m_append": true, "useAllFilesAccess": true, "allFilesPath": "/sdcard/OpenMacro"}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "fx", "m_type": 4, "dictionary": {}}]}}