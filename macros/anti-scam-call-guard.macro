{"macroExportVersion": 1, "macro": {"m_GUID": 8800000134, "m_name": "Anti-scam call guard", "m_description": "While you are on a call, an incoming SMS or notification that looks like a verification code (4-8 characters) triggers full scam defense (ported from BespredeL's Anti-Scam macro): the code notification is wiped from the shade, an alert SMS goes to a trusted contact, a loud warning appears, and a dialog offers End call — if nobody touches it for 30 seconds the call hangs up automatically. Replace the number in the Send SMS action with your trusted contact.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingSMSTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3, "m_smsContent": "\\b\\w{4,6}\\b", "m_exactMatch": false, "enableRegex": true, "ignoreCase": true}, {"m_classType": "NotificationTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_packageNameList": ["Any Application"], "m_textContent": "\\b\\w{4,8}\\b", "enableRegex": true, "ignoreCase": true, "m_ignoreOngoing": true}], "m_actionList": [{"m_classType": "ClearNotificationsAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_matchOption": 2, "m_matchText": "\\b\\w{4,6}\\b", "enableRegex": true, "ignoreCase": true, "m_clearPersistent": true}, {"m_classType": "SendSMSAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_number": "+70000000000", "m_messageContent": "Possible phone scam: someone on a call may be trying to get an SMS code from this phone."}, {"m_classType": "NotificationAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "Possible phone scam", "m_notificationText": "A code SMS arrived during a call — do NOT read the code to the caller!"}, {"m_classType": "OptionDialogAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_title": "Possible phone scam", "m_message": "Someone on this call may be trying to get an SMS verification code. Hang up — never share codes.", "m_buttonNames": ["Ignore", "End call"], "m_actionToRunJson": [null, "{\"m_classType\":\"RejectCallAction\",\"m_SIGUID\":990001,\"m_isDisabled\":false,\"m_isOrCondition\":false}"], "m_actionToRunClassType": [null, "RejectCallAction"], "m_actionToRunName": [null, "Reject call"], "m_defaultButton": 2, "m_defaultTimeOutSecs": 30, "blockNextAction": true}], "m_constraintList": [{"m_classType": "InCallConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_inCall": true}]}}