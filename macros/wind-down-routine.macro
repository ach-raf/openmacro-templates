{"macroExportVersion": 1, "macro": {"m_GUID": 8800000162, "m_name": "Bedtime wind-down", "m_description": "At 22:00 the phone winds down: alarms-only Do Not Disturb, dark theme, dim screen. Pair with morning-dnd-off for the morning.", "m_category": "Time & Focus", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 22, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "SetPriorityMode", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "DarkThemeAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "option": 0}, {"m_classType": "SetBrightnessAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "setBrightnessValue": true, "m_brightnessPercent": 15}, {"m_classType": "ToastAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Wind-down mode on", "m_duration": 2}], "m_constraintList": []}}