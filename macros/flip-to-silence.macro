{"macroExportVersion": 1, "macro": {"m_GUID": 8800000121, "m_name": "Flip to silence a call", "m_description": "Turn the phone face-down while a call is ringing to silence it — the classic flip-to-mute, no button needed.", "m_category": "Gestures", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "FlipDeviceTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_faceDown": true, "m_workWithScreenOff": true}], "m_actionList": [{"m_classType": "SetVibrateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_optionInt": 0, "m_constraintList": [{"m_classType": "InCallConstraint", "m_SIGUID": 2001, "m_isDisabled": false, "m_isOrCondition": false, "m_inCall": true}]}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Flipped — call silenced", "m_duration": 2}], "m_constraintList": []}}