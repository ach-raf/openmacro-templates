{"macroExportVersion": 1, "macro": {"m_GUID": 8800000131, "m_name": "Hold volume button — mute/restore media", "m_description": "Long-press a volume button to mute media instantly; long-press again to restore the exact level you had (ported from BespredeL's Fast Media Vol.). The current level is remembered in the 'level' variable, so mute/restore round-trips perfectly.", "m_category": "Gestures", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "VolumeButtonTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3, "m_dontChangeVolume": true}, {"m_classType": "VolumeButtonTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 2, "m_dontChangeVolume": true}], "m_actionList": [{"m_classType": "IfConditionAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "muted", "m_type": 0}, "m_booleanValue": false}]}, {"m_classType": "SetVariableAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "level", "m_type": 2}, "m_newStringValue": "{vol_music}"}, {"m_classType": "SetVolumeAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_streamIndexArray": [false, true, false, false, false, false, false, false], "m_streamVolumeArray": [0, 0, 0, 0, 0, 0, 0, 0], "m_volume": -1}, {"m_classType": "SetVariableAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "muted", "m_type": 0}, "m_newBooleanValue": true}, {"m_classType": "ToastAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Media muted at {lv=level}% — hold a volume button again to restore", "m_duration": 2}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 8001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "muted", "m_type": 0}, "m_booleanValue": true}]}, {"m_classType": "SetVolumeAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "m_streamIndexArray": [false, true, false, false, false, false, false, false], "m_streamVolumeArray": [0, 60, 0, 0, 0, 0, 0, 0], "m_volume": -1, "m_variables": [null, {"m_name": "level", "m_type": 2}, null, null, null, null, null, null]}, {"m_classType": "SetVariableAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "muted", "m_type": 0}, "m_newBooleanValue": false}, {"m_classType": "ToastAction", "m_SIGUID": 11, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Media volume restored to {lv=level}%", "m_duration": 2}, {"m_classType": "EndIfAction", "m_SIGUID": 12, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "level", "m_type": 2, "m_stringValue": ""}, {"m_name": "muted", "m_type": 0, "m_booleanValue": false}]}}