{"macroExportVersion": 1, "macro": {"m_GUID": 8800000113, "m_name": "Wi-Fi off when leaving home", "m_description": "When you leave your home area, Wi-Fi switches off to save battery. Edit the trigger to set your own coordinates and radius.", "m_category": "Location", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "LocationTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_enterArea": false, "m_geofenceId": "home", "m_newTriggerFromUnknown": 1, "m_latitude": 52.52, "m_longitude": 13.405, "m_radius": 150}], "m_actionList": [{"m_classType": "SetWifiAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_state": 1}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Leaving — Wi-Fi off", "m_duration": 2}], "m_constraintList": []}}