{"macroExportVersion": 1, "macro": {"m_GUID": 8800000114, "m_name": "Work mode — silence on office Wi-Fi", "m_description": "Detecting your office Wi-Fi switches the phone to silent+vibrate. Replace the SSID with your workplace network.", "m_category": "Location", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "WifiSSIDTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_SSID": "YourWorkWifi", "m_InRange": true}], "m_actionList": [{"m_classType": "SetVibrateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_optionInt": 0}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Work mode — silenced", "m_duration": 2}], "m_constraintList": []}}