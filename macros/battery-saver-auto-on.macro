{"macroExportVersion": 1, "macro": {"m_GUID": 8800000101, "m_name": "Battery saver auto-on", "m_description": "Turns battery saver on by itself when the battery drops to 20%, so you never run out of power because you forgot to flip the switch.", "m_category": "Battery", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "BatteryLevelTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_batteryLevel": 20, "m_decreasesTo": true}], "m_actionList": [{"m_classType": "BatterySaverAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Battery below 20% — battery saver enabled", "m_duration": 2}], "m_constraintList": []}}