{"macroExportVersion": 1, "macro": {"m_GUID": 8800000144, "m_name": "Stock below price alert", "m_description": "Every 15 minutes the price of your stock is fetched (Yahoo Finance chart feed, no key) and you get a notification once it falls below your limit. Edit the symbol at the end of the URL (AAPL, MSFT, ...) and the limit in the condition; you are notified once per drop.", "m_category": "Finance", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "RegularIntervalTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 900, "m_ignoreReferenceStartTime": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://query1.finance.yahoo.com/v8/finance/chart/AAPL", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp", "headerParams": [{"paramName": "User-Agent", "paramValue": "Mozilla/5.0"}]}}, {"m_classType": "JsonParseAction", "m_SIGUID": 20, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "quote"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=quote[chart][result][0][meta][regularMarketPrice]}", "variableName": "price", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 4001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "price", "m_type": 3}, "m_intLessThan": true, "m_doubleValue": 150.0}, {"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 4002, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "alerted", "m_type": 0}, "m_booleanValue": false}]}, {"m_classType": "NotificationAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "Stock alert", "m_notificationText": "Price dropped to {lv=price}"}, {"m_classType": "SetVariableAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "alerted", "m_type": 0}, "m_newBooleanValue": true}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 7001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "price", "m_type": 3}, "m_intGreaterThan": true, "m_doubleValue": 150.0}]}, {"m_classType": "SetVariableAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "alerted", "m_type": 0}, "m_newBooleanValue": false}, {"m_classType": "EndIfAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "quote", "m_type": 4, "dictionary": {}}, {"m_name": "price", "m_type": 3, "m_decimalValue": 0}, {"m_name": "alerted", "m_type": 0, "m_booleanValue": false}]}}