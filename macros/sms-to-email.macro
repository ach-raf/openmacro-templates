{"macroExportVersion": 1, "macro": {"m_GUID": 8800000142, "m_name": "Forward SMS to email", "m_description": "Every incoming SMS is emailed to you (IFTTT: Forward Android SMS to your Email inbox). Set your SMTP account in OpenMacro's More tab and put your address in the Send Email action.", "m_category": "Messaging", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingSMSTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}], "m_actionList": [{"m_classType": "SendEmailAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "sendOption": 1, "m_emailAddress": "you@example.com", "m_subject": "SMS from {sms_number}", "m_body": "{sms_text}"}], "m_constraintList": []}}