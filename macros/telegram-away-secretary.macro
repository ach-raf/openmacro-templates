{"macroExportVersion": 1, "macro": {"m_GUID": 8800000140, "m_name": "Telegram away auto-reply", "m_description": "Answers incoming Telegram Business messages when you are away: after a 60-second grace period (so you can answer manually first) the sender gets your away message (ported from BespredeL's Telegram Secretary; the AI reply of the original is replaced by the configurable away text because on-device AI is not built into OpenMacro yet — to answer with an LLM instead, extend the final branch: POST the message to any OpenAI-compatible chat endpoint, parse the reply with JsonParse and read {lv=ai[choices][0][message][content]}). Send /start from your own account once to register you as the owner.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "WebHookTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "identifier": "tgsec", "saveBodyVariableName": "resp"}], "m_actionList": [{"m_classType": "JsonParseAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "tg"}, {"m_classType": "IfConditionAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "text"], "dictionaryType": 2, "m_stringValue": "/start", "m_stringEqual": true}]}, {"m_classType": "SetVariableAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "ownerId", "m_type": 2}, "m_newStringValue": "{lv=tg[message][from][id]}"}, {"m_classType": "HttpRequestAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[message][chat][id]}"}, {"paramName": "text", "paramValue": "Owner registered — away replies will skip you."}]}}, {"m_classType": "EndIfAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "IfConditionAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 7001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["business_message", "text"], "dictionaryType": 2, "m_stringComparisonType": 1, "m_stringValue": ""}, {"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 7002, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["business_message", "from", "id"], "dictionaryType": 2, "m_stringValue": "{lv=ownerId}", "m_stringEqual": false}]}, {"m_classType": "PauseAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "m_delayInSeconds": 60, "m_useAlarm": true}, {"m_classType": "HttpRequestAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[business_message][chat][id]}"}, {"paramName": "text", "paramValue": "Hi! The owner is away right now and will answer you later. For urgent matters please call."}]}}, {"m_classType": "EndIfAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "botToken", "m_type": 2, "m_stringValue": ""}, {"m_name": "ownerId", "m_type": 2, "m_stringValue": ""}, {"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "tg", "m_type": 4, "dictionary": {}}]}}