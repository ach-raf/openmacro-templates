{"macroExportVersion": 1, "macro": {"m_GUID": 8800000132, "m_name": "Shake flashlight (dark only)", "m_description": "Shake the phone to toggle the flashlight — but only when it matters: the macro only reacts while the screen is on, the device is locked and the phone is not face-down on a table (ported from BespredeL's Flashlight). In daylight a shake turns the torch back off so it never burns in your pocket.", "m_category": "Gestures", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ShakeDeviceTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "VibrateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_vibratePattern": 12}, {"m_classType": "IfConditionAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "LightLevelConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_lightLevel": 50, "m_lightLevelFloat": 50.0}]}, {"m_classType": "CameraFlashLightAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_state": 2}, {"m_classType": "ElseAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "CameraFlashLightAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_state": 1}, {"m_classType": "EndIfAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [{"m_classType": "ScreenOnOffConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_screenOn": true}, {"m_classType": "DeviceLockedConstraint", "m_SIGUID": 900002, "m_isDisabled": false, "m_isOrCondition": false, "m_locked": true}, {"m_classType": "ProximitySensorConstraint", "m_SIGUID": 900003, "m_isDisabled": false, "m_isOrCondition": false, "m_near": false}]}}