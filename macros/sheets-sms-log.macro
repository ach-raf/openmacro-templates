{"macroExportVersion": 1, "macro": {"m_GUID": 8800000174, "m_name": "Google Sheets: log every SMS", "m_description": "Each incoming text is appended to a Google Sheet as time, sender and message. Set sheetId to your sheet's id. Connect Google in More > Accounts.", "m_category": "Messaging", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingSMSTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://sheets.googleapis.com/v4/spreadsheets/{lv=sheetId}/values/Sheet1!A1:append", "requestType": 1, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=google}"}], "contentType": "application/json", "contentBodyText": "{\"values\":[[\"{year}-{month_digit}-{dayofmonth} {hour}:{minute}\",\"{sms_number}\",\"{sms_text}\"]]}", "queryParams": [{"paramName": "valueInputOption", "paramValue": "USER_ENTERED"}]}}], "m_constraintList": [], "localVariables": [{"m_name": "sheetId", "m_type": 2, "m_stringValue": "YOUR_SHEET_ID"}]}}