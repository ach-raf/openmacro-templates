{"macroExportVersion": 1, "macro": {"m_GUID": 8800000167, "m_name": "Clipboard history log", "m_description": "Every time you copy something it is appended with the time to /sdcard/OpenMacro/clipboard.txt - a poor man's clipboard manager (a favourite 'underrated' iPhone shortcut).", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ClipboardChangeTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "", "isConfigured": true}], "m_actionList": [{"m_classType": "WriteToFileAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_logText": "{hour}:{minute} {clipboard_text}\n", "m_filename": "clipboard.txt", "m_append": true, "useAllFilesAccess": true, "allFilesPath": "/sdcard/OpenMacro"}], "m_constraintList": []}}