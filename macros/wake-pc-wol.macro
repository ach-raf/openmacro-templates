{"macroExportVersion": 1, "macro": {"m_GUID": 8800000138, "m_name": "Wake PC (Wake-on-LAN)", "m_description": "Powers on a computer on your network with a Wake-on-LAN magic packet: run the macro or tap its home-screen widget and the packet goes to the broadcast address on UDP port 9 (ported from BespredeL's Wake PC; the original's settings scenes are replaced by three plain variables). Set the 'mac' variable to your PC's MAC and the UDP action's destination to your network's broadcast (usually your IP with .255 at the end). The PC must have Wake-on-LAN enabled in its BIOS/UEFI and NIC driver.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "EmptyTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "WidgetPressedTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_widgetType": 0, "m_widgetLabel": "Wake PC"}], "m_actionList": [{"m_classType": "SetVariableAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "magicPacket", "m_type": 2}, "m_newStringValue": "FFFFFFFFFFFF"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=mac}", "m_textManipulation": {"type": "RemoveTextManipulation", "params": [":", "0"]}, "variableName": "macHex"}, {"m_classType": "LoopAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_fixedOptionCount": 16}, {"m_classType": "SetVariableAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "magicPacket", "m_type": 2}, "m_newStringValue": "{lv=magicPacket}{lv=macHex}"}, {"m_classType": "EndLoopAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "UDPCommandAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "m_destination": "192.168.1.255", "m_message": "0x{lv=magicPacket}", "m_port": 9}, {"m_classType": "ToastAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Magic packet sent to {lv=mac} at 192.168.1.255:9", "m_duration": 2}], "m_constraintList": [], "localVariables": [{"m_name": "mac", "m_type": 2, "m_stringValue": "AA:BB:CC:DD:EE:FF"}, {"m_name": "macHex", "m_type": 2, "m_stringValue": ""}, {"m_name": "magicPacket", "m_type": 2, "m_stringValue": ""}]}}