{"macroExportVersion": 1, "macro": {"m_GUID": 8800000126, "m_name": "Anti-theft: text 'locate' for GPS reply", "m_description": "Text this phone the word 'locate' and it replies by SMS with its current GPS coordinates — find a lost or stolen phone from any other phone.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingSMSTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3, "m_smsContent": "locate", "m_exactMatch": false, "ignoreCase": true}], "m_actionList": [{"m_classType": "ForceLocationUpdateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "timeoutSeconds": 30, "blockNextAction": true, "dictionaryVariableName": "loc"}, {"m_classType": "SendSMSAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_number": "{sms_number}", "m_messageContent": "My current location: {lv=loc[latitude]}, {lv=loc[longitude]}"}], "m_constraintList": [], "localVariables": [{"m_name": "loc", "m_type": 4, "dictionary": {}}]}}