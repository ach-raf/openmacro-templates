{"macroExportVersion": 1, "macro": {"m_GUID": 8800000172, "m_name": "Google Tasks: share to a new task", "m_description": "Share text to OpenMacro and it is added to your default Google Tasks list (IFTTT: Add Google Task). Connect Google in More > Accounts.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ShareTextTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://tasks.googleapis.com/tasks/v1/lists/@default/tasks", "requestType": 1, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=google}"}], "contentType": "application/json", "contentBodyText": "{\"title\":\"{shared_text}\"}"}}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Added to Google Tasks", "m_duration": 2}], "m_constraintList": []}}