{"macroExportVersion": 1, "macro": {"m_GUID": 8800000139, "m_name": "Telegram device bot", "m_description": "Controls this phone from a private Telegram chat: /ping answers, /geo replies with a Google Maps link of the current position, /ring plays a sound at full media volume, /reject_call ends the current call — anything else prints the command list (ported from BespredeL's Simple Telegram Bot, trimmed to its core commands; the original's note-taking, VirusTotal and DeepSeek commands were dropped). Only your Telegram user id is accepted — put it into the first If condition and your bot token into the 'botToken' variable.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "WebHookTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "identifier": "tgbot", "saveBodyVariableName": "resp"}], "m_actionList": [{"m_classType": "JsonParseAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "tg"}, {"m_classType": "IfConditionAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "chat", "id"], "dictionaryType": 2, "m_stringValue": "REPLACE_WITH_YOUR_USER_ID", "m_stringEqual": false}]}, {"m_classType": "HttpRequestAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[message][chat][id]}"}, {"paramName": "text", "paramValue": "Not authorized. Your chat id: {lv=tg[message][chat][id]}"}]}}, {"m_classType": "EndIfAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "IfConditionAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 6001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "chat", "id"], "dictionaryType": 2, "m_stringValue": "REPLACE_WITH_YOUR_USER_ID", "m_stringEqual": true}]}, {"m_classType": "IfConditionAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 7001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "text"], "dictionaryType": 2, "m_stringValue": "/ping", "m_stringEqual": true}]}, {"m_classType": "HttpRequestAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[message][chat][id]}"}, {"paramName": "text", "paramValue": "pong"}]}}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 9001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "text"], "dictionaryType": 2, "m_stringValue": "/geo", "m_stringEqual": true}]}, {"m_classType": "ForceLocationUpdateAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false, "timeoutSeconds": 20, "blockNextAction": true, "dictionaryVariableName": "loc"}, {"m_classType": "HttpRequestAction", "m_SIGUID": 11, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[message][chat][id]}"}, {"paramName": "text", "paramValue": "Location: {lv=loc[latitude]}, {lv=loc[longitude]} — https://maps.google.com/?q={lv=loc[latitude]},{lv=loc[longitude]}"}]}}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 12, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 12001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "text"], "dictionaryType": 2, "m_stringValue": "/ring", "m_stringEqual": true}]}, {"m_classType": "SetVolumeAction", "m_SIGUID": 13, "m_isDisabled": false, "m_isOrCondition": false, "m_streamIndexArray": [false, true, false, false, false, false, false, false], "m_streamVolumeArray": [0, 100, 0, 0, 0, 0, 0, 0], "m_volume": -1}, {"m_classType": "PlaySoundAction", "m_SIGUID": 14, "m_isDisabled": false, "m_isOrCondition": false, "m_filePath": "Bells", "specifyAudioStream": true, "audioStream": 3, "staticFilename": true}, {"m_classType": "HttpRequestAction", "m_SIGUID": 15, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.telegram.org/bot{lv=botToken}/sendMessage", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "chat_id", "paramValue": "{lv=tg[message][chat][id]}"}, {"paramName": "text", "paramValue": "Ringing — follow the sound"}]}}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 16, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 16001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "tg", "m_type": 4}, "dictionaryKeys": ["message", "text"], "dictionaryType": 2, "m_stringValue": "/reject_call", "m_stringEqual": true}]