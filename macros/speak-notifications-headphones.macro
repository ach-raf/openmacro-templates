{"macroExportVersion": 1, "macro": {"m_GUID": 8800000165, "m_name": "Read messages aloud on headphones", "m_description": "With headphones connected, new WhatsApp, Telegram and Signal messages are spoken aloud (sender and text) so you never touch the phone.", "m_category": "Car & Audio", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "NotificationTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_packageNameList": ["com.whatsapp", "org.telegram.messenger", "org.thoughtcrime.securesms"], "m_excludeApps": false, "m_ignoreOngoing": true}], "m_actionList": [{"m_classType": "SpeakTextAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_textToSay": "{notification_title} says {notification_text}", "m_skipEmojis": true}], "m_constraintList": [{"m_classType": "HeadphonesConnectionConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_connected": true}]}}