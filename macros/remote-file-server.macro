{"macroExportVersion": 1, "macro": {"m_GUID": 8800000137, "m_name": "LAN file server (JSON API)", "m_description": "Exposes the phone's files to your Wi-Fi: an HTTP endpoint lists a folder as JSON, deletes a file, or creates a folder — no cloud, LAN only (ported from BespredeL's Remote Filemanager; the 92-action original serves a full HTML UI, this build is the JSON API it talks to). Open http://<phone-ip>:<port>/rfm?cmd=list&dir=/sdcard in a browser or script — the port shows when the macro arms. Add &name=<file> for delete, or cmd=mkdir to create a folder.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "HttpServerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "identifier": "rfm", "queryParamsDictionaryName": "q"}], "m_actionList": [{"m_classType": "IfConditionAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 2001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "q", "m_type": 4}, "dictionaryKeys": ["cmd"], "dictionaryType": 2, "m_stringValue": "list", "m_stringEqual": true}]}, {"m_classType": "ClearVariablesAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "variableNames": ["files", "filesJson"]}, {"m_classType": "FileOperationAllFilesAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "option": 4, "fromPath": "{lv=q[dir]}", "listFilesVariableName": "files", "listFilesSortAscending": true, "waitToComplete": true}, {"m_classType": "JsonOutputAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "dictionaryVarName": "files", "stringVarName": "filesJson"}, {"m_classType": "HttpServerResponseAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "option": 0, "text": "{lv=filesJson}", "responseCode": "OK", "headerParams": [{"paramName": "Content-Type", "paramValue": "application/json"}]}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 7001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "q", "m_type": 4}, "dictionaryKeys": ["cmd"], "dictionaryType": 2, "m_stringValue": "delete", "m_stringEqual": true}]}, {"m_classType": "FileOperationAllFilesAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "option": 2, "fileOption": 5, "filePattern": "{lv=q[name]}", "fromPath": "{lv=q[dir]}", "waitToComplete": true}, {"m_classType": "HttpServerResponseAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "option": 0, "text": "deleted", "responseCode": "OK"}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 10001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "q", "m_type": 4}, "dictionaryKeys": ["cmd"], "dictionaryType": 2, "m_stringValue": "mkdir", "m_stringEqual": true}]}, {"m_classType": "FileOperationAllFilesAction", "m_SIGUID": 11, "m_isDisabled": false, "m_isOrCondition": false, "option": 3, "folderName": "{lv=q[name]}", "fromPath": "{lv=q[dir]}"}, {"m_classType": "HttpServerResponseAction", "m_SIGUID": 12, "m_isDisabled": false, "m_isOrCondition": false, "option": 0, "text": "created", "responseCode": "OK"}, {"m_classType": "ElseAction", "m_SIGUID": 13, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "HttpServerResponseAction", "m_SIGUID": 14, "m_isDisabled": false, "m_isOrCondition": false, "option": 0, "text": "unknown cmd — use list|delete|mkdir with dir and name", "responseCode": "OK"}, {"m_classType": "EndIfAction", "m_SIGUID": 15, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "q", "m_type": 4, "dictionary": {}}, {"m_name": "files", "m_type": 4, "dictionary": {}}, {"m_name": "filesJson", "m_type": 2, "m_stringValue": ""}]}}