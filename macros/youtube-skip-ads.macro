{"macroExportVersion": 1, "macro": {"m_GUID": 8800000141, "m_name": "YouTube ad skipper", "m_description": "While YouTube is in the foreground: when a 'Skip' button appears it is tapped for you, when an ad's 'Visit advertiser' label shows up media is muted, and when the label disappears your volume comes back (ported from BespredeL's AutoSkip YouTube Ads; the Shorts flow and the 79-language detection of the original were dropped — matched texts are for the English UI, edit them in the triggers for other languages). Needs the accessibility service for screen reading and tapping.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ScreenContentTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "textToMatch": "Skip", "ignoreCase": true, "packageNameList": ["com.google.android.youtube"], "m_constraintList": [{"m_classType": "ActiveApplicationConstraint", "m_SIGUID": 1001, "m_isDisabled": false, "m_isOrCondition": false, "m_active": true, "m_foreground": true, "m_packageNameList": ["com.google.android.youtube"]}]}, {"m_classType": "ScreenContentTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "textToMatch": "Visit advertiser", "ignoreCase": true, "packageNameList": ["com.google.android.youtube"], "m_constraintList": [{"m_classType": "ActiveApplicationConstraint", "m_SIGUID": 2001, "m_isDisabled": false, "m_isOrCondition": false, "m_active": true, "m_foreground": true, "m_packageNameList": ["com.google.android.youtube"]}]}, {"m_classType": "ScreenContentTrigger", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "textToMatch": "Visit advertiser", "ignoreCase": true, "packageNameList": ["com.google.android.youtube"], "isOffScreen": true, "m_constraintList": [{"m_classType": "ActiveApplicationConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_active": true, "m_foreground": true, "m_packageNameList": ["com.google.android.youtube"]}]}], "m_actionList": [{"m_classType": "IfConditionAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "TriggerThatInvokedConstraint", "m_SIGUID": 4001, "m_isDisabled": false, "m_isOrCondition": false, "m_triggerIndex": 0}]}, {"m_classType": "UIInteractionAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "uiInteractionConfiguration": {"type": "Click", "clickOption": "1", "textContent": "Skip", "blocking": "false"}}, {"m_classType": "VibrateAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_vibratePattern": 12}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "TriggerThatInvokedConstraint", "m_SIGUID": 7001, "m_isDisabled": false, "m_isOrCondition": false, "m_triggerIndex": 1}]}, {"m_classType": "SetVolumeAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false, "m_streamIndexArray": [false, true, false, false, false, false, false, false], "m_streamVolumeArray": [0, 0, 0, 0, 0, 0, 0, 0], "m_volume": -1}, {"m_classType": "ToastAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Ad muted", "m_duration": 2}, {"m_classType": "ElseIfConditionAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "TriggerThatInvokedConstraint", "m_SIGUID": 10001, "m_isDisabled": false, "m_isOrCondition": false, "m_triggerIndex": 2}]}, {"m_classType": "SetVolumeAction", "m_SIGUID": 11, "m_isDisabled": false, "m_isOrCondition": false, "m_streamIndexArray": [false, true, false, false, false, false, false, false], "m_streamVolumeArray": [0, 60, 0, 0, 0, 0, 0, 0], "m_volume": -1}, {"m_classType": "ToastAction", "m_SIGUID": 12, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Volume restored to 60%", "m_duration": 2}, {"m_classType": "EndIfAction", "m_SIGUID": 13, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": []}}