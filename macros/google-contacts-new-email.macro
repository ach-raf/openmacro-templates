{"macroExportVersion": 1, "macro": {"m_GUID": 8800000175, "m_name": "Email me new Google Contacts", "m_description": "Every 30 minutes the most recently changed Google contact is checked; when it is a new one you get an email with its name and number (IFTTT: Email new Google Contacts details). Needs SMTP (More tab) and Google connected in More > Accounts.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "RegularIntervalTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 1800, "m_ignoreReferenceStartTime": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://people.googleapis.com/v1/people/me/connections", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=google}"}], "queryParams": [{"paramName": "personFields", "paramValue": "names,phoneNumbers,emailAddresses"}, {"paramName": "sortOrder", "paramValue": "LAST_MODIFIED_DESCENDING"}, {"paramName": "pageSize", "paramValue": "1"}], "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "people"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=people[connections][0][resourceName]}", "variableName": "newId", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newId", "m_type": 2}, "m_stringComparisonType": 0, "m_stringEqual": false, "m_stringValue": "{lv=lastId}"}, {"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5002, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newId", "m_type": 2}, "m_stringComparisonType": 2, "m_stringValue": "{lv="}]}, {"m_classType": "SendEmailAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "sendOption": 1, "m_emailAddress": "you@example.com", "m_subject": "New contact", "m_body": "{lv=people[connections][0][names][0][displayName]}\n{lv=people[connections][0][phoneNumbers][0][value]}\n{lv=people[connections][0][emailAddresses][0][value]}"}, {"m_classType": "SetVariableAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "lastId", "m_type": 2}, "m_newStringValue": "{lv=newId}"}, {"m_classType": "EndIfAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "people", "m_type": 4, "dictionary": {}}, {"m_name": "newId", "m_type": 2, "m_stringValue": ""}, {"m_name": "lastId", "m_type": 2, "m_stringValue": ""}]}}