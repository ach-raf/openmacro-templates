{"macroExportVersion": 1, "macro": {"m_GUID": 8800000127, "m_name": "Driving auto-reply", "m_description": "While a Bluetooth device is connected (your car), any incoming SMS gets an automatic reply sent from its notification — 'I'm driving'.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingSMSTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}], "m_actionList": [{"m_classType": "NotificationReplyAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "packageName": "", "matchText": "", "replyText": "I'm driving right now — I'll get back to you soon."}], "m_constraintList": [{"m_classType": "BluetoothConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_btState": 2, "m_anyDevice": true}]}}