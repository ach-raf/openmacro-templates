{"macroExportVersion": 1, "macro": {"m_GUID": 8800000102, "m_name": "Battery full alert", "m_description": "Vibrates and notifies you when the battery reaches 95% while charging, so you can unplug in time and go easy on the cell.", "m_category": "Battery", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "BatteryLevelTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_batteryLevel": 95, "m_decreasesTo": false}], "m_actionList": [{"m_classType": "VibrateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_vibratePattern": 1}, {"m_classType": "NotificationAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "Battery almost full", "m_notificationText": "Battery is at 95% or more — you can unplug the charger."}], "m_constraintList": [{"m_classType": "ExternalPowerConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_externalPower": true}]}}