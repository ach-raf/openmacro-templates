{"macroExportVersion": 1, "macro": {"m_GUID": 8800000136, "m_name": "Child device activity reporter", "m_description": "Turns a child's phone into a reporter: every call (incoming/missed/outgoing), SMS, notification, Wi-Fi-free GPS position every 15 minutes and app install/removal is sent as an HTTP request to your own receiver URL (ported from BespredeL's Parental Control; the parent-side viewer and offline archive of the 220-action original are out of scope — the receiver stores what it gets). Fields from triggers that did not fire arrive as literal {token} text — have the receiver ignore those.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingCallTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "CallMissedTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "OutgoingCallTrigger", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "IncomingSMSTrigger", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3, "ignoreCase": true}, {"m_classType": "NotificationTrigger", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_packageNameList": ["Any Application"], "m_ignoreOngoing": true, "m_supressMultiples": true}, {"m_classType": "RegularIntervalTrigger", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 900, "m_useAlarm": true}, {"m_classType": "ApplicationInstalledRemovedTrigger", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_installed": true}, {"m_classType": "ApplicationInstalledRemovedTrigger", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 9, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://YOUR-RECEIVER.example/report", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "queryParams": [{"paramName": "time", "paramValue": "{year}-{month_digit}-{dayofmonth} {hour}:{minute}:{sec}"}, {"paramName": "call", "paramValue": "{call_number}"}, {"paramName": "sms_from", "paramValue": "{sms_number}"}, {"paramName": "sms_text", "paramValue": "{sms_message}"}, {"paramName": "notification", "paramValue": "{not_app_name}: {not_title} {notification}"}, {"paramName": "lat", "paramValue": "{last_loc_lat}"}, {"paramName": "lng", "paramValue": "{last_loc_long}"}, {"paramName": "app", "paramValue": "{app_package} {app_name}"}]}}, {"m_classType": "LogAction", "m_SIGUID": 10, "m_isDisabled": false, "m_isOrCondition": false, "m_logText": "Activity report sent", "logLevel": 20}], "m_constraintList": []}}