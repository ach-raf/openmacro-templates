{"macroExportVersion": 1, "macro": {"m_GUID": 8800000171, "m_name": "Todoist: share to a new task", "m_description": "Share any text or link to OpenMacro and it becomes a Todoist task in your Inbox. Connect Todoist (or paste your personal API token) in More > Accounts. Avoid double quotes in shared text.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ShareTextTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.todoist.com/rest/v2/tasks", "requestType": 1, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=todoist}"}], "contentType": "application/json", "contentBodyText": "{\"content\":\"{shared_text}\"}"}}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Added to Todoist", "m_duration": 2}], "m_constraintList": []}}