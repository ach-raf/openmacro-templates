{"macroExportVersion": 1, "macro": {"m_GUID": 8800000166, "m_name": "Announce who is calling", "m_description": "Incoming calls are announced out loud with the caller's number, so you can tell who is ringing without looking at the phone.", "m_category": "Car & Audio", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "IncomingCallTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}], "m_actionList": [{"m_classType": "SpeakTextAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_textToSay": "Incoming call from {call_number}", "m_readNumbersIndividually": true}], "m_constraintList": []}}