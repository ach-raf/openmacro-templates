{"macroExportVersion": 1, "macro": {"m_GUID": 8800000150, "m_name": "New RSS item notification", "m_description": "Checks an RSS feed every 30 minutes and posts a notification for each new top item (IFTTT: Post new RSS feed items to ...). Put the feed URL in the request; the macro remembers the last item so you are told once.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "RegularIntervalTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 1800, "m_ignoreReferenceStartTime": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://hnrss.org/newest?points=100", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp", "headerParams": [{"paramName": "User-Agent", "paramValue": "android:app.openmacro:v1.0 (feed reader)"}]}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "feed"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=feed[rss][channel][item][0][link]}", "variableName": "newId", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newId", "m_type": 2}, "m_stringComparisonType": 0, "m_stringEqual": false, "m_stringValue": "{lv=lastId}"}]}, {"m_classType": "NotificationAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "{lv=feed[rss][channel][title]}", "m_notificationText": "{lv=feed[rss][channel][item][0][title]}"}, {"m_classType": "SetVariableAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "lastId", "m_type": 2}, "m_newStringValue": "{lv=newId}"}, {"m_classType": "EndIfAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "feed", "m_type": 4, "dictionary": {}}, {"m_name": "newId", "m_type": 2, "m_stringValue": ""}, {"m_name": "lastId", "m_type": 2, "m_stringValue": ""}]}}