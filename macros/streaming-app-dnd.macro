{"macroExportVersion": 1, "macro": {"m_GUID": 8800000151, "m_name": "Do Not Disturb while streaming", "m_description": "Opening Netflix turns Do Not Disturb on so calls and pings do not interrupt the show; closing it turns Do Not Disturb off again. Swap the package name for YouTube (com.google.android.youtube), Disney+ or any video app.", "m_category": "Apps", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ApplicationLaunchedTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_launched": true, "m_packageNameList": ["com.netflix.mediaclient"], "usePackageNameOption": 0, "isAllApps": false, "excludeMode": false}, {"m_classType": "ApplicationLaunchedTrigger", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_launched": false, "m_packageNameList": ["com.netflix.mediaclient"], "usePackageNameOption": 0, "isAllApps": false, "excludeMode": false}], "m_actionList": [{"m_classType": "IfConditionAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "TriggerThatInvokedConstraint", "m_SIGUID": 3001, "m_isDisabled": false, "m_isOrCondition": false, "m_triggerIndex": 0}]}, {"m_classType": "SetPriorityMode", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 3}, {"m_classType": "ElseAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "SetPriorityMode", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0}, {"m_classType": "EndIfAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": []}}