{"macroExportVersion": 1, "macro": {"m_GUID": 8800000173, "m_name": "Google Sheets: daily currency rate", "m_description": "Once a day the USD to EUR rate is appended as a new row to your Google Sheet (IFTTT: log daily currency exchange rates to Google Sheets). Put the sheet id (from its URL) in the sheetId variable. Connect Google in More > Accounts.", "m_category": "Finance", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 9, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "fx"}, {"m_classType": "HttpRequestAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://sheets.googleapis.com/v4/spreadsheets/{lv=sheetId}/values/Sheet1!A1:append", "requestType": 1, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=google}"}], "contentType": "application/json", "contentBodyText": "{\"values\":[[\"{lv=fx[date]}\",\"USD\",\"EUR\",{lv=fx[rates][EUR]}]]}", "queryParams": [{"paramName": "valueInputOption", "paramValue": "USER_ENTERED"}]}}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "fx", "m_type": 4, "dictionary": {}}, {"m_name": "sheetId", "m_type": 2, "m_stringValue": "YOUR_SHEET_ID"}]}}