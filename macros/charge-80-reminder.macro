{"macroExportVersion": 1, "macro": {"m_GUID": 8800000154, "m_name": "Unplug reminder at 80%", "m_description": "While charging, a notification tells you when the battery reaches 80% so you can unplug and keep the battery healthier (a popular Apple Shortcuts automation).", "m_category": "Battery", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "BatteryLevelTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_batteryLevel": 80, "m_decreasesTo": false}], "m_actionList": [{"m_classType": "NotificationAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "Battery at 80%", "m_notificationText": "Unplug the charger to protect the battery"}], "m_constraintList": [{"m_classType": "ExternalPowerConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_externalPower": true, "m_powerConnectedOptions": [true, true, true]}]}}