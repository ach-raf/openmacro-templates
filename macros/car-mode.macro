{"macroExportVersion": 1, "macro": {"m_GUID": 8800000117, "m_name": "Car mode — maps + greeting", "m_description": "When your phone pairs with the car, Google Maps opens and a voice wishes you a safe drive. Set your head unit's Bluetooth name in the trigger.", "m_category": "Car & Audio", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "BluetoothTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_btState": 2, "m_deviceName": "YourCar", "m_anyDevice": false}], "m_actionList": [{"m_classType": "LaunchActivityAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "option": 1, "m_packageToLaunch": "com.google.android.apps.maps", "m_applicationName": "Maps"}, {"m_classType": "SpeakTextAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_textToSay": "Connected to the car. Have a safe drive."}], "m_constraintList": []}}