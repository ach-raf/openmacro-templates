{"macroExportVersion": 1, "macro": {"m_GUID": 8800000156, "m_name": "Low battery: text my location", "m_description": "When the battery falls to 5%, your location is texted to someone you trust so they know where you were. Put their number in the action.", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "BatteryLevelTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_option": 0, "m_batteryLevel": 5, "m_decreasesTo": true}], "m_actionList": [{"m_classType": "ForceLocationUpdateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "timeoutSeconds": 20, "blockNextAction": true, "dictionaryVariableName": "loc"}, {"m_classType": "SendSMSAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_number": "+10000000000", "m_messageContent": "Battery at 5%. Last location: https://maps.google.com/?q={lv=loc[latitude]},{lv=loc[longitude]}"}], "m_constraintList": [], "localVariables": [{"m_name": "loc", "m_type": 4, "dictionary": {}}]}}