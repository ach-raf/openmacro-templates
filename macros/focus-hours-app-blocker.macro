{"macroExportVersion": 1, "macro": {"m_GUID": 8800000153, "m_name": "Block distracting apps in work hours", "m_description": "Between 09:00 and 17:00 on weekdays, opening Instagram, TikTok or Facebook sends you straight back to the home screen with a reminder. Edit the package list to taste.", "m_category": "Apps", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ApplicationLaunchedTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_launched": true, "usePackageNameOption": 0, "isAllApps": false, "excludeMode": false, "m_packageNameList": ["com.instagram.android", "com.zhiliaoapp.musically", "com.facebook.katana"]}], "m_actionList": [{"m_classType": "LaunchHomeScreenAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "useAccessibilityService": true}, {"m_classType": "ToastAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Focus hours - back to work", "m_duration": 2}], "m_constraintList": [{"m_classType": "TimeOfDayConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_startHour": 9, "m_startMinute": 0, "m_endHour": 17, "m_endMinute": 0}, {"m_classType": "DayOfWeekConstraint", "m_SIGUID": 900002, "m_isDisabled": false, "m_isOrCondition": false, "m_daysOfWeek": [false, true, true, true, true, true, false]}]}}