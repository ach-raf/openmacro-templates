{"macroExportVersion": 1, "macro": {"m_GUID": 8800000170, "m_name": "Spotify: liked songs into a playlist", "m_description": "Every 5 minutes your newest liked Spotify song is checked; a new one is added to the playlist whose id you set in the playlistId variable (the part of the playlist link after /playlist/). Connect Spotify in More > Accounts first. Only the newest like is checked, so keep the interval short.", "m_category": "Music", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "RegularIntervalTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 300, "m_ignoreReferenceStartTime": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.spotify.com/v1/me/tracks?limit=1", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=spotify}"}], "saveResponseType": 1, "responseVariableName": "liked"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "liked", "dictionaryVarName": "likedDict"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=likedDict[items][0][track][uri]}", "variableName": "newUri", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newUri", "m_type": 2}, "m_stringComparisonType": 0, "m_stringEqual": false, "m_stringValue": "{lv=lastUri}"}, {"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5002, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newUri", "m_type": 2}, "m_stringComparisonType": 2, "m_stringValue": "{lv="}]}, {"m_classType": "HttpRequestAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.spotify.com/v1/playlists/{lv=playlistId}/tracks", "requestType": 1, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=spotify}"}], "queryParams": [{"paramName": "uris", "paramValue": "{lv=newUri}"}]}}, {"m_classType": "SetVariableAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "lastUri", "m_type": 2}, "m_newStringValue": "{lv=newUri}"}, {"m_classType": "EndIfAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "liked", "m_type": 2, "m_stringValue": ""}, {"m_name": "likedDict", "m_type": 4, "dictionary": {}}, {"m_name": "newUri", "m_type": 2, "m_stringValue": ""}, {"m_name": "lastUri", "m_type": 2, "m_stringValue": ""}, {"m_name": "playlistId", "m_type": 2, "m_stringValue": "YOUR_PLAYLIST_ID"}]}}