{"macroExportVersion": 1, "macro": {"m_GUID": 8800000169, "m_name": "Tell me when IFTTT adds services", "m_description": "Once a day the public IFTTT services list is fetched; if its size changed since the last check you get a notification (IFTTT: new service published). The first run only records the baseline.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 10, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://ifttt.com/explore/services.json", "requestType": 0, "requestTimeOutSeconds": 60, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp", "headerParams": [{"paramName": "User-Agent", "paramValue": "Mozilla/5.0"}]}}, {"m_classType": "TextManipulationAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{strlen=resp}", "variableName": "newLen", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "CompareValueConstraint", "m_SIGUID": 4001, "m_isDisabled": false, "m_isOrCondition": false, "type": 1, "value1": "{lv=lastLen}", "value2": "0", "comparisonType": 3}, {"m_classType": "CompareValueConstraint", "m_SIGUID": 4002, "m_isDisabled": false, "m_isOrCondition": false, "type": 1, "value1": "{lv=newLen}", "value2": "{lv=lastLen}", "comparisonType": 1}]}, {"m_classType": "NotificationAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "IFTTT", "m_notificationText": "The IFTTT services list changed - new services may be available"}, {"m_classType": "EndIfAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false}, {"m_classType": "SetVariableAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "lastLen", "m_type": 2}, "m_newStringValue": "{lv=newLen}"}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "newLen", "m_type": 2, "m_stringValue": ""}, {"m_name": "lastLen", "m_type": 2, "m_stringValue": "0"}]}}