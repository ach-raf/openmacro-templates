{"macroExportVersion": 1, "macro": {"m_GUID": 8800000130, "m_name": "Morning weather briefing (TTS)", "m_description": "Weekday mornings the phone fetches today's weather (Open-Meteo, no API key) and reads it aloud. Edit the URL to your own latitude/longitude.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 7, "m_minute": 30, "m_second": 0, "m_daysOfWeek": [false, true, true, true, true, true, false], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current=temperature_2m,apparent_temperature", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "weather"}, {"m_classType": "SpeakTextAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_textToSay": "Good morning. It is {lv=weather[current][temperature_2m]} degrees, feels like {lv=weather[current][apparent_temperature]} degrees."}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "weather", "m_type": 4, "dictionary": {}}]}}