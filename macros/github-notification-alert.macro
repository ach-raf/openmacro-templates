{"macroExportVersion": 1, "macro": {"m_GUID": 8800000176, "m_name": "GitHub notification alert", "m_description": "Every 10 minutes your newest unread GitHub notification is shown as a phone notification once. Connect GitHub (or paste a personal access token with the notifications scope) in More > Accounts.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "RegularIntervalTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_seconds": 600, "m_ignoreReferenceStartTime": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.github.com/notifications", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "headerParams": [{"paramName": "Authorization", "paramValue": "Bearer {oauth=github}"}], "queryParams": [{"paramName": "per_page", "paramValue": "1"}], "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "n"}, {"m_classType": "TextManipulationAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_text": "{lv=n[entries][0][id]}", "variableName": "newId", "m_textManipulation": {"type": "TrimManipulation"}}, {"m_classType": "IfConditionAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_constraintList": [{"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5001, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newId", "m_type": 2}, "m_stringComparisonType": 0, "m_stringEqual": false, "m_stringValue": "{lv=lastId}"}, {"m_classType": "MacroDroidVariableConstraint", "m_SIGUID": 5002, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "newId", "m_type": 2}, "m_stringComparisonType": 2, "m_stringValue": "{lv="}]}, {"m_classType": "NotificationAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "GitHub: {lv=n[entries][0][repository][full_name]}", "m_notificationText": "{lv=n[entries][0][subject][title]}"}, {"m_classType": "SetVariableAction", "m_SIGUID": 7, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "lastId", "m_type": 2}, "m_newStringValue": "{lv=newId}"}, {"m_classType": "EndIfAction", "m_SIGUID": 8, "m_isDisabled": false, "m_isOrCondition": false}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "n", "m_type": 4, "dictionary": {}}, {"m_name": "newId", "m_type": 2, "m_stringValue": ""}, {"m_name": "lastId", "m_type": 2, "m_stringValue": ""}]}}