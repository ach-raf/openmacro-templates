{"macroExportVersion": 1, "macro": {"m_GUID": 8800000143, "m_name": "6 AM weather email", "m_description": "At 6:00 every morning you get an email with the current weather (Open-Meteo, no API key). Edit the latitude/longitude in the URL and the address in the email action.", "m_category": "Utilities", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "TimerTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_hour": 6, "m_minute": 0, "m_second": 0, "m_daysOfWeek": [true, true, true, true, true, true, true], "m_useAlarm": true}], "m_actionList": [{"m_classType": "HttpRequestAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "requestConfig": {"urlToOpen": "https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&current=temperature_2m,apparent_temperature,precipitation,wind_speed_10m", "requestType": 0, "requestTimeOutSeconds": 30, "followRedirects": true, "saveResponseType": 1, "responseVariableName": "resp"}}, {"m_classType": "JsonParseAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "stringVarName": "resp", "dictionaryVarName": "weather"}, {"m_classType": "SendEmailAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "sendOption": 1, "m_emailAddress": "you@example.com", "m_subject": "Today's weather", "m_body": "Temperature {lv=weather[current][temperature_2m]} C, feels like {lv=weather[current][apparent_temperature]} C, wind {lv=weather[current][wind_speed_10m]} km/h, precipitation {lv=weather[current][precipitation]} mm."}], "m_constraintList": [], "localVariables": [{"m_name": "resp", "m_type": 2, "m_stringValue": ""}, {"m_name": "weather", "m_type": 4, "dictionary": {}}]}}