{"macroExportVersion": 1, "macro": {"m_GUID": 8800000133, "m_name": "Shake for contact QR", "m_description": "Shake the phone on your home screen and a QR code with your contact details appears full-screen — let people scan you instead of dictating numbers (ported from BespredeL's ShakeContacts). Change the qrText in the action to your number or link: tel:+10000000000, https://t.me/yourhandle or https://wa.me/10000000000.", "m_category": "Gestures", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "ShakeDeviceTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false}], "m_actionList": [{"m_classType": "VibrateAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_vibratePattern": 1}, {"m_classType": "GenerateQRCodeAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "qrText": "tel:+10000000000", "displayMode": 0, "fullScreenMode": true, "themeMode": 0}, {"m_classType": "ToastAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_messageText": "Edit the QR text in the macro to share your details", "m_duration": 2}], "m_constraintList": [{"m_classType": "ScreenOnOffConstraint", "m_SIGUID": 900001, "m_isDisabled": false, "m_isOrCondition": false, "m_screenOn": true}, {"m_classType": "LauncherIsInForegroundConstraint", "m_SIGUID": 900002, "m_isDisabled": false, "m_isOrCondition": false, "m_inForeground": true}]}}