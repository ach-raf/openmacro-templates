{"macroExportVersion": 1, "macro": {"m_GUID": 8800000135, "m_name": "Intruder camera on failed unlock", "m_description": "After 2 failed unlock attempts within 10 minutes the front camera snaps a photo, GPS coordinates are captured, and both are saved to /sdcard/OpenMacro/IntruderCam together with a Google Maps link in a timestamped text file, followed by a notification (ported from BespredeL's IntruderCam; the rear-camera shot, 30 s video and the browser-based map viewer of the 89-action original were dropped for the store build).", "m_category": "Safety", "m_enabled": true, "m_completed": true, "m_isOrCondition": false, "m_triggerList": [{"m_classType": "FailedLoginTrigger", "m_SIGUID": 1, "m_isDisabled": false, "m_isOrCondition": false, "m_numFailures": 2, "m_timeIndex": 3}], "m_actionList": [{"m_classType": "SetVariableAction", "m_SIGUID": 2, "m_isDisabled": false, "m_isOrCondition": false, "m_variable": {"m_name": "stamp", "m_type": 2}, "m_newStringValue": "{year}-{month_digit}-{dayofmonth}_{hour}_{minute}_{sec}"}, {"m_classType": "ForceLocationUpdateAction", "m_SIGUID": 3, "m_isDisabled": false, "m_isOrCondition": false, "timeoutSeconds": 20, "blockNextAction": true, "dictionaryVariableName": "loc"}, {"m_classType": "TakePictureAction", "m_SIGUID": 4, "m_isDisabled": false, "m_isOrCondition": false, "m_useFrontCamera": true, "useAllFilesAccess": true, "allFilesPath": "/sdcard/OpenMacro/IntruderCam", "customFilename": "intruder_{lv=stamp}"}, {"m_classType": "WriteToFileAction", "m_SIGUID": 5, "m_isDisabled": false, "m_isOrCondition": false, "m_logText": "Failed unlock at {lv=stamp}\nPhoto: intruder_{lv=stamp}.jpg\nGPS: {lv=loc[latitude]}, {lv=loc[longitude]}\nMap: https://maps.google.com/?q={lv=loc[latitude]},{lv=loc[longitude]}", "m_filename": "{lv=stamp}.txt", "overwrite": true, "useAllFilesAccess": true, "allFilesPath": "/sdcard/OpenMacro/IntruderCam"}, {"m_classType": "NotificationAction", "m_SIGUID": 6, "m_isDisabled": false, "m_isOrCondition": false, "m_notificationSubject": "IntruderCam", "m_notificationText": "Failed unlock recorded — photo and GPS saved in /sdcard/OpenMacro/IntruderCam"}], "m_constraintList": [], "localVariables": [{"m_name": "stamp", "m_type": 2, "m_stringValue": ""}, {"m_name": "loc", "m_type": 4, "dictionary": {}}]}}