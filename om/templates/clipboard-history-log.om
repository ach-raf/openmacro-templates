// Teaches: appending to a file. Every run adds one line, so the file becomes a history.
const LOG_FILE = "/sdcard/OpenMacro/clipboard.txt"

macro "Clipboard history log" {
  description: "Every time you copy something it is appended with the time to /sdcard/OpenMacro/clipboard.txt - a poor man's clipboard manager (a favourite 'underrated' iPhone shortcut)."
  category: "Quick Actions"
  tags: ["popular", "clipboard", "history", "log"]
  // Android 10+ lets only the foreground app read the clipboard, so a copy made in the background logs an empty line.
  on clipboard.changed(e)

  file.write(path: LOG_FILE, text: "{now().format("HH:mm")} {e.text}\n", mode: .append)
}
