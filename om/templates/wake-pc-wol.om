// Teaches: building binary-ish text with a function. A Wake-on-LAN "magic packet" is 6 bytes of FF
// followed by the PC's MAC address repeated 16 times - `repeat` makes that one line.
const MAC = "AA:BB:CC:DD:EE:FF"

const BROADCAST = "192.168.1.255"

fn magicPacketHex(mac: text) -> text = "FFFFFFFFFFFF" + mac.replace(":", "").repeat(16)

macro "Wake PC (Wake-on-LAN)" {
  description: "Powers on a computer on your network with a Wake-on-LAN magic packet: run the macro or tap its home-screen widget (place the OpenMacro button widget and name it Wake PC) and the packet goes to the broadcast address on UDP port 9. You'll be asked for the PC's network (MAC) address and the broadcast address when you add it."
  category: "Power Users"
  tags: ["wake-on-lan", "pc", "udp", "remote", "bespredel"]
  on macro.manual
  // fires when a home-screen widget labelled exactly "Wake PC" is tapped (or run it from the app)
  on widget.button(label: "Wake PC")

  udp.send(host: BROADCAST, port: 9, hex: magicPacketHex(MAC))
  toast.show(message: "Magic packet sent to {MAC} at {BROADCAST}:9")
}
