// Teaches: two triggers share a constant, and `trigger.invoked(1)` says which one fired.
// `app.launched` fires when the app opens; its sibling for closing is not available yet.
const NETFLIX = "com.netflix.mediaclient"

macro "Unlock rotation in video apps" {
  description: "Auto-rotate switches on while Netflix is open and off again when you leave it, so the phone stays portrait everywhere else. Change the package for any video app."
  category: "Apps"
  tags: ["popular", "netflix", "rotation", "video"]
  on app.launched(apps: [NETFLIX])
  // closing Netflix (the foreground app changed away) fires app.closed for it
  on app.closed(apps: [NETFLIX])

  rotate.auto(on: trigger.invoked(1))
}
