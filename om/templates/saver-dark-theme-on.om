// Teaches: reacting to a system state change. Pairs with "Dark theme with battery saver (off)".
macro "Dark theme with battery saver (on)" {
  description: "Battery saver switched on? The system dark theme comes with it - easy on the eyes and the battery at the same time."
  category: "Battery"
  on batterySaver.turnedOn

  theme.dark(on: true)
}
