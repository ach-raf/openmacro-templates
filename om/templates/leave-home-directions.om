// Teaches: combining a package function (directionsUrl) with a named guard (commuteTime).
// url.open hands the link to whatever maps app the phone prefers.
include "@openmacro/maps"
include "std/time.om"

const WORKPLACE = "Work"

// Monday to Friday, 06:00-10:00.
fn commuteTime() -> bool = time.between("06:00", "10:00") and isWeekday(now())

macro "Directions to work when I leave home" {
  description: "On weekday mornings (6-10) leaving home opens driving directions to your workplace. Edit the destination constant and the coordinates in the trigger."
  category: "Location"
  tags: ["popular", "directions", "commute", "maps", "location"]
  // The home area: replace the coordinates with your own (radius is metres around them).
  on location.left(lat: 52.52, lon: 13.405, radius: 150, name: "Home") where commuteTime()

  url.open(url: directionsUrl(WORKPLACE))
}
