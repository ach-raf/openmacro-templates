// Teaches: error-prone steps wrapped in small functions with a plain name. `http.send(saveTo:)` keeps
// the raw bytes of the picture; `setWallpaper` then applies it.
include "std/http.om"
include "std/json.om"

// NASA's public demo key works for light use; get a free key at api.nasa.gov for more.
const APOD_URL = "https://api.nasa.gov/planetary/apod?api_key=DEMO_KEY"

const PICTURE_FILE = "/sdcard/OpenMacro/apod.jpg"

fn downloadFile(url: text, path: text) {
  // saveTo keeps the raw bytes (the interpreter's .body stays the text view of the same response)
  http.send(url: url, saveTo: path)
}

fn setWallpaper(path: text) {
  wallpaper.set(path: path)
}

macro "NASA picture of the day wallpaper" {
  description: "Each morning the NASA Astronomy Picture of the Day becomes your wallpaper. Uses NASA's public DEMO_KEY; get a free key at api.nasa.gov for heavy use. Days when NASA posts a video instead of an image are skipped."
  category: "Daily Info"
  tags: ["ifttt", "nasa", "wallpaper", "space", "apod"]
  on time.at(time: "08:00")

  let apod = getJson(APOD_URL)
  if getText(apod, "media_type") == "image" {
    downloadFile(getText(apod, "url") ?? "", PICTURE_FILE)
    setWallpaper(PICTURE_FILE)
  }
}
