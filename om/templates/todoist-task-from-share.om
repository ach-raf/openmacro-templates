// Teaches: the share-sheet pattern with an account package. The package talks to the connected account, the macro holds no credentials.
include "@openmacro/todoist"

macro "Todoist: share to a new task" {
  description: "Share any text or link to OpenMacro and it becomes a Todoist task in your Inbox. Connect Todoist once in More -> Connections."
  category: "Connected Accounts"
  tags: ["oauth", "todoist", "tasks", "share"]
  // the Android share sheet offers OpenMacro; the shared text arrives as the event's `text`
  on share.received

  let shared = trigger.event().text as text
  if addTodoistTask(shared) {
    toast.show(message: "Added to Todoist")
  } else {
    toast.show(message: "Todoist refused the task - check More -> Connections")
  }
}
