// Teaches: telling two kinds of message apart, remembering who you are (a `global`), and waiting before answering.
// Telegram sends private chats as "message" and Business chats as "business_message".
include "@openmacro/telegram-bot"
include "std/json.om"

const AWAY_TEXT = "Hi! The owner is away right now and will answer you later. For urgent matters please call."

const GRACE = 1m

// Filled in by "/start": replies skip this person so you never answer yourself.
global ownerId: text = ""

macro "Telegram away auto-reply" {
  description: "Answers incoming Telegram Business messages when you are away: after a 1-minute grace period (so you can answer manually first) the sender gets your away message. Send /start to your bot from your own account once to register you as the owner. (Ported from BespredeL's Telegram Secretary; its AI reply is replaced by a fixed away text because on-device AI is not available yet.) Installing asks for your bot token."
  category: "Utilities"
  on webhook.received(identifier: "tgsec")

  let update = parseJson(trigger.event().body as text)
  let msg = readUpdate(update)
  if getPath(update, "business_message") == null {
    if msg.text.lower() == "/start" {
      global.ownerId = msg.fromId
      telegramReply(msg.chatId, "Owner registered - away replies will skip you.")
    }
    return
  }
  if msg.fromId != global.ownerId {
    delay(duration: GRACE)
    telegramReply(msg.chatId, AWAY_TEXT)
  }
}
