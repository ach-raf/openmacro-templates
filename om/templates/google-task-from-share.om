// Teaches: checking a result. The package function returns whether Google accepted the request,
// so the macro can tell you instead of claiming success.
include "@openmacro/google"

macro "Google Tasks: share to a new task" {
  description: "Share text to OpenMacro and it is added to your default Google Tasks list (IFTTT: Add Google Task). Connect Google once in More -> Connections."
  category: "Utilities"
  tags: ["oauth", "google", "tasks", "share"]
  // the Android share sheet offers OpenMacro; the shared text arrives as the event's `text`
  on share.received

  let shared = trigger.event().text as text
  if addGoogleTask(shared) {
    toast.show(message: "Added to Google Tasks")
  } else {
    toast.show(message: "Google refused the task - check More -> Connections")
  }
}
