// Teaches: a routine is just several steps in order. Steps run top to bottom.
// Pair with "Morning - end do not disturb".
macro "Bedtime wind-down" {
  description: "At 22:00 the phone winds down: alarms-only Do Not Disturb, dark theme, dim screen. Pair with morning-dnd-off for the morning."
  category: "Time & Focus"
  tags: ["popular", "bedtime", "sleep", "night", "dnd"]
  on time.at(time: "22:00")

  dnd.setMode(mode: .alarms)
  theme.dark(on: true)
  brightness.set(percent: 15)
  toast.show(message: "Wind-down mode on")
}
