// Teaches: the mirror of "Wi-Fi on when arriving home" - the same area, but the trigger is "leaves".
macro "Wi-Fi off when leaving home" {
  description: "When you leave your home area, Wi-Fi switches off to save battery. Edit the trigger to set your own coordinates and radius."
  category: "Location"
  // GAP TG-01: no location (enter / leave area) trigger yet.
  on legacy.trigger("LocationTrigger")

  wifi.set(on: false)
  toast.show(message: "Leaving - Wi-Fi off")
}
