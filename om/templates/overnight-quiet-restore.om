// Teaches: two small macros beat one big one - this is the undo for "Overnight quiet charging".
// brightness.auto hands control back to the system instead of guessing the old value.
macro "Overnight quiet - restore on unplug" {
  description: "The counterpart to 'Overnight quiet charging': unplugging the charger ends alarms-only mode and puts brightness back to adaptive."
  category: "Sleep & Focus"
  tags: ["charging", "do not disturb", "night", "restore"]
  on power.disconnected

  dnd.setMode(mode: .off)
  brightness.auto(on: true)
}
