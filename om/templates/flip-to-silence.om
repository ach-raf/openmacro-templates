// Teaches: `if` inside a macro - only react when a call is really going on.
macro "Flip to silence a call" {
  description: "Turn the phone face-down while a call is ringing to silence it - the classic flip-to-mute, no button needed."
  category: "Gestures"
  tags: ["call", "silence", "gesture", "flip"]
  // GAP TG-10: no face-down / flip trigger yet.
  on legacy.trigger("FlipDeviceTrigger")

  if call.active() {
    ringer.set(mode: .vibrate)
    toast.show(message: "Flipped - call silenced")
  }
}
