// Teaches: a record from a package (`Contact`) and the poll-and-notify pattern with a sent email.
include "@openmacro/google"

const SEND_TO = "you@example.com"

global lastContactId: text = ""

macro "Email me new Google Contacts" {
  description: "Every 30 minutes the most recently changed Google contact is checked; when it is a new one an email with its name and number is sent to you (IFTTT: Email new Google Contacts details). Connect Google in More -> Connections and set your SMTP account in More -> Mail."
  category: "Utilities"
  tags: ["oauth", "google", "contacts", "email"]
  on time.every(interval: 30m)

  let contact = newestContact()
  if contact == null {
    return
  }
  if contact.id != global.lastContactId {
    email.send(to: SEND_TO, subject: "New contact", body: "{contact.name}\n{contact.phone}\n{contact.email}")
    global.lastContactId = contact.id
  }
}
