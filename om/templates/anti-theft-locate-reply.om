// Teaches: a command by text message, and a function from a package. Text "locate" to this phone from another
// phone and it answers with a map link to where it is.
include "@openmacro/maps"

macro "Anti-theft: text 'locate' for GPS reply" {
  description: "Text this phone the word 'locate' and it replies by SMS with its current GPS coordinates - find a lost or stolen phone from any other phone."
  category: "Safety"
  tags: ["security", "sms", "location", "anti-theft"]
  on sms.received(e) where e.body.trim().lower() == "locate"

  let here = location.now()
  sms.send(number: e.sender, message: "My current location: {mapsLink(here.lat, here.lon)}")
}
