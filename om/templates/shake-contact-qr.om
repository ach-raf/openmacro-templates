// Teaches: a text constant that holds your own data - edit CONTACT and nothing else.
const CONTACT = "tel:+10000000000"

macro "Shake for contact QR" {
  description: "Shake the phone on your home screen and a QR code with your contact details appears full-screen - let people scan you instead of dictating numbers (ported from BespredeL's ShakeContacts). Change the QR text first."
  category: "Gestures"
  on shake.detected where screen.on() and launcher.foreground()

  vibrate.run()
  // GAP TG-08: no QR-code capability yet.
  legacy.action("GenerateQRCodeAction", {text: CONTACT, fullScreen: true})
  toast.show(message: "Edit the QR text in the macro to share your details")
}
