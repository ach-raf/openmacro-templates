// Teaches: a decimal function with one job. `data.usage` needs Usage access (and READ_PHONE_STATE for
// the SIM id); without those grants the run stops at the function and says what is missing.
fn weeklyDataUsedGb() -> decimal {
  return data.usage(period: .week)
}

macro "Weekly mobile data report" {
  description: "Every Monday at 08:00 the week's mobile data usage is measured and posted as a notification."
  category: "Utilities"
  tags: ["data usage", "report", "weekly", "network"]
  // time.at fires daily; the guard keeps Mondays only (weekday 1).
  on time.at(time: "08:00") where now().weekday == 1

  notify.show(title: "Weekly data usage", body: "Mobile data this week: {weeklyDataUsedGb()} GB")
}
