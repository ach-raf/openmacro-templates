// Teaches: the same trigger as "Low battery warning", pointed the other way (falling: false = rising).
macro "Battery full alert" {
  description: "Vibrates and notifies you when the battery reaches 95% while charging, so you can unplug in time and go easy on the cell."
  category: "Battery"
  on battery.reached(level: 95, falling: false) where power.charging()

  vibrate.run()
  notify.show(title: "Battery almost full", body: "Battery is at 95% or more - you can unplug the charger.")
}
