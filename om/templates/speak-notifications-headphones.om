// Teaches: reading a notification (`e.app`, `e.title`, `e.text`) while filtering it with the trigger's own `apps` argument.
// `(e, apps: ...)` binds the event and passes the filter in one line.
const CHAT_APPS = ["com.whatsapp", "org.telegram.messenger", "org.thoughtcrime.securesms"]

macro "Read messages aloud on headphones" {
  description: "With headphones connected, new WhatsApp, Telegram and Signal messages are spoken aloud (sender and text) so you never touch the phone."
  category: "Car & Headphones"
  tags: ["popular", "tts", "notifications", "messages", "headphones"]
  on notification.received(e, apps: CHAT_APPS) where headphones.connected()

  tts.speak(text: "{e.title} says {e.text}")
}
