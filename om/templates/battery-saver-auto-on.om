// Teaches: the smallest useful macro - one trigger, then the steps that run.
// `battery.reached` fires once as the level crosses 20% on its way down (falling: true).
macro "Battery saver auto-on" {
  description: "Turns battery saver on by itself when the battery drops to 20%, so you never run out of power because you forgot to flip the switch."
  category: "Battery"
  on battery.reached(level: 20, falling: true)

  // GAP TG-08: there is no capability for the battery-saver switch yet, so this step is a placeholder.
  legacy.action("BatterySaverAction", {})
  toast.show(message: "Battery below 20% - battery saver enabled")
}
