// Teaches: forwarding. The event's `sender` and `body` go straight into the message.
const SEND_TO = "you@example.com"

macro "Forward SMS to email" {
  description: "Every incoming SMS is emailed to you. You'll be asked for your email address when you add it; set your SMTP account once in More -> Mail."
  category: "Connected Accounts"
  tags: ["ifttt", "sms", "email", "forward"]
  on sms.received(e)

  email.send(to: SEND_TO, subject: "SMS from {e.sender}", body: e.body)
}
