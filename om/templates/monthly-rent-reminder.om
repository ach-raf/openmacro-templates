// Teaches: building a calendar rule from a clock trigger and a guard.
// There is no "day of month" trigger: fire every day at 09:00 and let `where` pass only on the 1st (`now().day`).
macro "Monthly rent reminder" {
  description: "On the 1st of every month at 09:00 you get a reminder notification. The reminder text and day aren't asked when you add it; change them afterwards in the macro for any monthly bill."
  category: "Reminders"
  tags: ["popular", "monthly", "reminder", "bills", "rent"]
  on time.at(time: "09:00") where now().day == 1

  notify.show(title: "Rent due", body: "It is the 1st - time to pay the rent")
}
