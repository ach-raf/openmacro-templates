// Teaches: one function for two opposite outcomes. The macro body is a single call that reads like a sentence.
fn alwaysOnDisplay(on: bool) {
  // GAP TG-08: no capability for the always-on (ambient) display setting yet.
  legacy.action("AmbientDisplayAction", {on: on})
}

macro "Always-on display at work" {
  description: "Arriving at work turns the always-on display on so the clock is glanceable at the desk; leaving turns it off to save battery."
  category: "Location"
  tags: ["popular", "aod", "work", "location", "display"]
  // GAP TG-01: no location trigger yet (placeholder 1 = arrive, placeholder 2 = leave).
  on legacy.trigger("LocationTrigger")
  on legacy.trigger("LocationTrigger")

  alwaysOnDisplay(trigger.invoked(1))
}
