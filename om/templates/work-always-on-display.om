// Teaches: one function for two opposite outcomes. The macro body is a single call that reads like a sentence.
fn alwaysOnDisplay(on: bool) {
  // The system always-on (ambient) display; WRITE_SECURE_SETTINGS (adb grant) is the key it writes.
  display.alwaysOn(on: on)
}

macro "Always-on display at work" {
  description: "Arriving at work turns the always-on display on so the clock is glanceable at the desk; leaving turns it off to save battery. The place is set to an example spot in Berlin and isn't asked when you add it; change it to your workplace afterwards in the macro's trigger."
  category: "Places"
  tags: ["popular", "aod", "work", "location", "display"]
  // The work area: replace the coordinates with your own (radius is metres around them).
  // Line 1 = arrive (display on), line 2 = leave (display off) - trigger.invoked(1) tells them apart.
  on location.entered(lat: 52.515, lon: 13.415, radius: 200, name: "Work")
  on location.left(lat: 52.515, lon: 13.415, radius: 200, name: "Work")

  alwaysOnDisplay(trigger.invoked(1))
}
