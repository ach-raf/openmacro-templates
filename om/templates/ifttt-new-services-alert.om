// Teaches: change detection without parsing. The macro only compares the size of the page with last time;
// the first run records a baseline and says nothing.
include "std/http.om"

const SERVICES_URL = "https://ifttt.com/explore/services.json"

global lastLength: int = 0

macro "Tell me when IFTTT adds services" {
  description: "Once a day the public IFTTT services list is fetched; if its size changed since the last check you get a notification. The first run only records the baseline."
  category: "Daily Info"
  tags: ["popular", "ifttt", "services", "notification"]
  on time.at(time: "10:00")

  let length = httpGet(SERVICES_URL, headers: {"User-Agent": "Mozilla/5.0"}, timeout: 1m).body.length
  if global.lastLength > 0 and length != global.lastLength {
    notify.show(title: "IFTTT", body: "The IFTTT services list changed - new services may be available")
  }
  global.lastLength = length
}
