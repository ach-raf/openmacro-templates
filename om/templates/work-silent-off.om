// Teaches: binding the event (`e`) and testing it. `wifi.disconnected` has no filter argument, so the macro
// asks `e.ssid` itself. It is the only way to tell which network was lost.
const OFFICE = "Office-WiFi"

macro "Work mode - leave office Wi-Fi" {
  description: "Losing your office Wi-Fi restores the normal loud ringer. Replace the SSID with your workplace network."
  category: "Location"
  on wifi.disconnected(e) where e.ssid == OFFICE

  ringer.set(mode: .normal)
}
