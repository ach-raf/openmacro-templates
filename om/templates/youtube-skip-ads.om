// Teaches: three situations, one macro. Each `on` line is a different thing seen on screen, and
// `trigger.invoked(n)` picks the response. Needs the accessibility service (the arming warning says so).
const YOUTUBE = "com.google.android.youtube"

const NORMAL_VOLUME = 60

macro "YouTube ad skipper" {
  description: "While YouTube is in the foreground: when a 'Skip' button appears it is tapped for you, when an ad's 'Visit advertiser' label shows up media is muted, and when the label goes away the volume comes back."
  category: "Utilities"
  tags: ["youtube", "ads", "skip", "mute", "accessibility", "bespredel"]
  // the accessibility service watches YouTube's window for these texts (the where-guard keeps it silent elsewhere)
  on screen.text.seen(text: "Skip") where app.foreground([YOUTUBE])
  on screen.text.seen(text: "Visit advertiser") where app.foreground([YOUTUBE])
  on screen.text.gone(text: "Visit advertiser") where app.foreground([YOUTUBE])

  if trigger.invoked(1) {
    // tap the real button by its visible label
    ui.tap(text: "Skip")
    vibrate.run()
  } else if trigger.invoked(2) {
    volume.set(stream: .media, level: 0)
    toast.show(message: "Ad muted")
  } else {
    volume.set(stream: .media, level: NORMAL_VOLUME)
    toast.show(message: "Volume restored to {NORMAL_VOLUME}%")
  }
}
