// Teaches: sending a last message while there is still power left.
include "@openmacro/maps"

const TRUSTED_NUMBER = "+10000000000"

macro "Low battery: text my location" {
  description: "When the battery falls to 5%, your location is texted to someone you trust so they know where you were. You'll be asked for their number when you add it."
  category: "Safety"
  tags: ["popular", "battery", "sos", "location", "sms"]
  on battery.reached(level: 5, falling: true)

  // The battery is nearly flat: ask for a fresh fix, but fall back to the last known one quickly.
  let here = location.now(timeout: 15s)
  sms.send(number: TRUSTED_NUMBER, message: "Battery at 5%. Last location: {mapsLink(here.lat, here.lon)}")
}
