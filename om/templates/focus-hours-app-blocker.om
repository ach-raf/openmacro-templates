// Teaches: guards built from helpers. `workHours()` names the rule, so the trigger line reads like the sentence
// "when a distracting app opens during work hours". `isWeekday` comes from std/time.om.
include "std/time.om"

const DISTRACTING = ["com.instagram.android", "com.zhiliaoapp.musically", "com.facebook.katana"]

// Monday to Friday, 09:00-17:00.
fn workHours() -> bool = time.between("09:00", "17:00") and isWeekday(now())

macro "Block distracting apps in work hours" {
  description: "Between 09:00 and 17:00 on weekdays, opening Instagram, TikTok or Facebook sends you straight back to the home screen with a reminder. Edit the package list to taste."
  category: "Apps"
  tags: ["popular", "focus", "productivity", "apps", "block"]
  on app.launched(apps: DISTRACTING) where workHours()

  // the accessibility service performs the home action (arming warns while it is off)
  ui.goHome()
  toast.show(message: "Focus hours - back to work")
}
