// Teaches: a long guard read as a list of conditions. Each `and` term is one thing that must hold.
// Shaking in a pocket must not light the torch, so the macro also checks that the phone is not face-down.
const DARK_LUX = 50

macro "Shake flashlight (dark only)" {
  description: "Shake the phone to toggle the flashlight - but only when it matters: the macro only reacts while the screen is on, the device is locked and the phone is not face-down on a table (ported from BespredeL's 'Shake Torch')."
  category: "Quick Actions"
  tags: ["flashlight", "torch", "shake", "gesture", "dark", "bespredel"]
  on shake.detected where screen.on() and device.locked() and not proximity.near()

  vibrate.run()
  // Switch it on only in a dark room; in daylight a shake can only turn it off.
  if light.level() < DARK_LUX {
    torch.toggle()
  } else {
    torch.set(on: false)
  }
}
