// Teaches: a Bluetooth trigger. `e.device` is the name of the device that just connected, so the macro can tell the car from earbuds.
const MAPS = "com.google.android.apps.maps"

const CAR = "My Car"

macro "Car mode - maps + greeting" {
  description: "When your phone pairs with the car, Google Maps opens and a voice wishes you a safe drive. You'll be asked for your head unit's Bluetooth name when you add it."
  category: "Car & Headphones"
  tags: ["car", "bluetooth", "driving", "maps"]
  on bluetooth.connected(e) where e.device == CAR

  app.launch(package: MAPS)
  tts.speak(text: "Connected to the car. Have a safe drive.")
}
