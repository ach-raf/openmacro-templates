// Teaches: the same trigger idea for power - plug in, play.
macro "Play music when charging starts" {
  description: "Plugging in the charger resumes your music player - handy at the desk or in the car."
  category: "Car & Headphones"
  tags: ["popular", "charger", "music", "media"]
  on power.connected

  media.control(command: .play)
}
