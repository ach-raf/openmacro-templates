// Teaches: the poll-and-notify pattern used as poll-and-act - when a new liked song appears, add it to a playlist.
// GAP TG-16: no account sign-in yet. Installing the package asks you to paste an access token.
include "@openmacro/spotify"

// The id in a playlist's share link: open.spotify.com/playlist/<this part>
const PLAYLIST_ID = "YOUR_PLAYLIST_ID"

global lastUri: text = ""

macro "Spotify: liked songs into a playlist" {
  description: "Every 5 minutes your newest liked Spotify song is checked; a new one is added to the playlist whose id you set in PLAYLIST_ID. Installing asks for a Spotify access token."
  category: "Music"
  on time.every(interval: 5m)

  let uri = newestLikedUri()
  if not uri.isEmpty() and uri != global.lastUri {
    addToPlaylist(PLAYLIST_ID, uri)
    global.lastUri = uri
  }
}
