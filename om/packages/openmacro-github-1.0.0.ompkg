{
    "format": "openmacro-package/1",
    "manifest": {
        "name": "@openmacro/github",
        "version": "1.0.0",
        "lang": 1,
        "entry": "main.om",
        "description": "Your newest unread GitHub notification",
        "license": "GPL-3.0-only",
        "requires": {
            "capabilities": [
                "http.send"
            ],
            "permissions": [
                "INTERNET"
            ],
            "effects": [
                "network"
            ]
        },
        "dependencies": {},
        "setup": [
            {
                "key": "token",
                "type": "secret",
                "prompt": "GitHub personal access token (notifications scope)"
            }
        ]
    },
    "files": {
        "main.om": "// @openmacro/github - read notifications with a personal access token (\"@openmacro/github/token\").\ninclude \"std/http.om\"\ninclude \"std/json.om\"\n\ntype Notification { id: text, repo: text, title: text }\n\n// The newest unread notification, or null when there is none.\nfn newestNotification() -> Notification? {\n  let items = getJson(\n    \"https://api.github.com/notifications\",\n    {per_page: \"1\"},\n    mergeHeaders(bearer(secret(\"@openmacro/github/token\")), {Accept: \"application/vnd.github+json\"}),\n  )\n  let id = getText(items, \"0.id\") ?? \"\"\n  if id.isEmpty() {\n    return null\n  }\n  return Notification(id: id, repo: getText(items, \"0.repository.full_name\") ?? \"\", title: getText(items, \"0.subject.title\") ?? \"\")\n}\n"
    },
    "sha256": "dc2eb44ce9753839b8ded6be548f45e7a8801be46157c6b752131a56006864e7"
}
