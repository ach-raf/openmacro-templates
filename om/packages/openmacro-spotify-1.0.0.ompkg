{
    "format": "openmacro-package/1",
    "manifest": {
        "name": "@openmacro/spotify",
        "version": "1.0.0",
        "lang": 1,
        "entry": "main.om",
        "description": "Spotify liked songs and playlists",
        "license": "GPL-3.0-only",
        "requires": {
            "capabilities": [
                "http.send"
            ],
            "permissions": [
                "INTERNET"
            ],
            "effects": [
                "network"
            ]
        },
        "dependencies": {},
        "setup": [
            {
                "key": "token",
                "type": "secret",
                "prompt": "Spotify access token (user-library-read, playlist-modify-private)"
            }
        ]
    },
    "files": {
        "main.om": "// @openmacro/spotify - the newest liked song and adding a song to a playlist (\"@openmacro/spotify/token\").\ninclude \"std/http.om\"\ninclude \"std/json.om\"\n\nfn spotifyAuth() -> map<text, text> = bearer(secret(\"@openmacro/spotify/token\"))\n\n// The Spotify URI of the song you liked last, or \"\" when there is none.\nfn newestLikedUri() -> text {\n  let page = getJson(\"https://api.spotify.com/v1/me/tracks\", {limit: \"1\"}, spotifyAuth())\n  return getText(page, \"items.0.track.uri\") ?? \"\"\n}\n\nfn addToPlaylist(playlistId: text, uri: text) -> bool =\n  isSuccess(httpPost(withQuery(\"https://api.spotify.com/v1/playlists/{playlistId}/tracks\", {uris: uri}), headers: spotifyAuth()))\n"
    },
    "sha256": "5300cce053de9c6cb1569ac4fc43e4496be900a2ab530ed544e2cd53b831c8e4"
}
