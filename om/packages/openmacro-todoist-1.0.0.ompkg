{
    "format": "openmacro-package/1",
    "manifest": {
        "name": "@openmacro/todoist",
        "version": "1.0.0",
        "lang": 1,
        "entry": "main.om",
        "description": "Add tasks to your Todoist inbox",
        "license": "GPL-3.0-only",
        "requires": {
            "capabilities": [
                "http.send",
                "json.stringify"
            ],
            "permissions": [
                "INTERNET"
            ],
            "effects": [
                "network"
            ]
        },
        "dependencies": {},
        "setup": [
            {
                "key": "token",
                "type": "secret",
                "prompt": "Todoist API token (Settings > Integrations > Developer)"
            }
        ]
    },
    "files": {
        "main.om": "// @openmacro/todoist - add a task to the Inbox (\"@openmacro/todoist/token\").\ninclude \"std/http.om\"\n\nfn addTodoistTask(content: text) -> bool =\n  isSuccess(postJson(\"https://api.todoist.com/rest/v2/tasks\", {content: content}, bearer(secret(\"@openmacro/todoist/token\"))))\n"
    },
    "sha256": "62c860602634b2ecb72b3949ec6d9acfd0a5c092cf8d76ebfb64cba8b0b36299"
}
