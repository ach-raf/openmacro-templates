{
    "format": "openmacro-package/1",
    "manifest": {
        "name": "@openmacro/feeds",
        "version": "1.0.0",
        "lang": 1,
        "entry": "main.om",
        "description": "Read the newest item of an RSS or Atom feed",
        "license": "GPL-3.0-only",
        "requires": {
            "capabilities": [
                "http.send"
            ],
            "permissions": [
                "INTERNET"
            ],
            "effects": [
                "network"
            ]
        },
        "dependencies": {},
        "setup": []
    },
    "files": {
        "main.om": "// @openmacro/feeds - the newest item of a feed, without an XML parser.\n// Feeds are regular enough that cutting text between tags is all a notifier needs.\ninclude \"std/http.om\"\ninclude \"std/text.om\"\n\ntype FeedItem { id: text, title: text, link: text }\n\n// Feed text sometimes wraps values in CDATA markers; strip them.\nfn clean(s: text) -> text = s.replace(\"<![CDATA[\", \"\").replace(\"]]>\", \"\").trim()\n\nfn tag(block: text, name: text) -> text = clean(between(block, \"<{name}>\", \"</{name}>\") ?? \"\")\n\n// The first <item> of an RSS feed. Its id is the <guid>, or the link when there is none.\nfn newestRssItem(xml: text) -> FeedItem? {\n  let item = between(xml, \"<item>\", \"</item>\") ?? \"\"\n  if item.isEmpty() {\n    return null\n  }\n  let link = tag(item, \"link\")\n  let guid = tag(item, \"guid\")\n  return FeedItem(id: if guid.isEmpty() then link else guid, title: tag(item, \"title\"), link: link)\n}\n\n// The first <entry> of an Atom feed (Reddit, GitHub, YouTube, ...).\nfn newestAtomEntry(xml: text) -> FeedItem? {\n  let entry = between(xml, \"<entry>\", \"</entry>\") ?? \"\"\n  if entry.isEmpty() {\n    return null\n  }\n  return FeedItem(id: tag(entry, \"id\"), title: tag(entry, \"title\"), link: between(entry, \"<link href=\\\"\", \"\\\"\") ?? \"\")\n}\n\n// Download a feed. Many sites reject requests without a User-Agent.\nfn fetchFeed(url: text) -> text =\n  httpGet(url, headers: {\"User-Agent\": \"android:app.openmacro:v1.0 (feed reader)\"}).body\n"
    },
    "sha256": "ef35224fe4a1e8af48a1c3365d2699e93dbdc8525f1691291658643025622490"
}
